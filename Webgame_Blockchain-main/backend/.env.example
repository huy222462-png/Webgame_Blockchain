# Backend Environment Variables Example
# Copy this file to .env and fill in your actual values

# MongoDB Connection
# Get this from MongoDB Atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://vinh223378_db_user:Vinh5167943@cluster0.h5qahvo.mongodb.net/webgame?retryWrites=true&w=majority

# Server Configuration
PORT=5000

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_key_here

# Bomdog Economy Settings
BOMDOG_EXCHANGE_POINTS=1000
BOMDOG_EXCHANGE_COIN=10
BOMDOG_UPGRADE_BASE_COST=30
BOMDOG_UPGRADE_MULTIPLIER=1.5
BOMDOG_CLICK_BASE_POINTS=25
BOMDOG_CLICK_POINTS_MULTIPLIER=1.25
BOMDOG_IDLE_BASE_COIN=12
BOMDOG_IDLE_COIN_MULTIPLIER=1.2
BOMDOG_IDLE_MAX_HOURS=24
BOMDOG_MIN_WITHDRAW=50

# On-chain Withdraw Configuration (Ethereum/Polygon)
BOMDOG_RPC_URL=https://polygon-rpc.com
BOMDOG_WITHDRAWER_KEY=0x_private_key_for_withdraw_wallet
BOMDOG_CONTRACT_ADDRESS=0xYourBomdogContract
# Optional: override ABI/method if contract differs
# BOMDOG_CONTRACT_ABI=["function withdraw(address to, uint256 amount) external"]
# BOMDOG_WITHDRAW_METHOD=withdraw(address,uint256)
BOMDOG_COIN_DECIMALS=18
BOMDOG_WITHDRAW_CONFIRMATIONS=1
BOMDOG_WITHDRAW_GAS_LIMIT=220000

# ================================
# HEDERA CONFIGURATION (Recommended for lower fees)
# ================================

# Hedera Account Settings
# Get from: https://portal.hedera.com/
BOMDOG_HEDERA_ACCOUNT_ID=0.0.7775085
BOMDOG_HEDERA_PRIVATE_KEY=0xYourHederaPrivateKeyHere
BOMDOG_HEDERA_NETWORK=testnet

# Hedera Token Settings
# Create token first: node scripts/create-hedera-token.js
BOMDOG_HEDERA_TOKEN_ID=0.0.XXXXXXX
BOMDOG_COIN_SYMBOL=BOMDOG

# ⚠️ IMPORTANT: 
# If BOMDOG_HEDERA_ACCOUNT_ID and BOMDOG_HEDERA_TOKEN_ID are set,
# the system will automatically use Hedera instead of Ethereum.
# Otherwise, it will fallback to Ethereum/EVM configuration above.

# ================================
# How to switch between networks:
# ================================
# 
# USE HEDERA: Set all BOMDOG_HEDERA_* variables
# USE ETHEREUM: Leave BOMDOG_HEDERA_* empty or remove them
#
